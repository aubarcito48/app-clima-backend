# Copiar como .env usando scripts/create_local_env.py. Nunca versionar el .env real.
# Las variables del sistema/hosting tienen prioridad sobre este archivo.
DJANGO_SECRET_KEY=
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
CORS_ALLOWED_ORIGINS=http://localhost:4200,http://127.0.0.1:4200
# Producción: DEBUG=false, hosts exactos y orígenes HTTPS (HTTP solo loopback).
# Activar únicamente detrás de un proxy que controle X-Forwarded-Proto.
DJANGO_TRUST_PROXY_HTTPS=false

# OpenWeather se usa desde TK04. Groq y su modelo se usan en el servicio de TK06.
# Agregar claves reales solo en .env local del backend o en variables de Render.
OPENWEATHER_API_KEY=
OPENWEATHER_CONNECT_TIMEOUT_SECONDS=3
OPENWEATHER_READ_TIMEOUT_SECONDS=5
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
GROQ_CONNECT_TIMEOUT_SECONDS=3
GROQ_READ_TIMEOUT_SECONDS=8
GROQ_MAX_COMPLETION_TOKENS=160

# Opcional: directorio con es_ES-sharvard-medium.onnx y su .onnx.json.
# Por defecto: models/piper-sharvard dentro del backend.
ISA_MODEL_DIR=

# Presupuestos globales por proceso y ventana móvil de 60 segundos, activos en producción.
API_CLIMATE_REQUESTS_PER_MINUTE=30
API_PLACES_REQUESTS_PER_MINUTE=120
API_ALERTS_REQUESTS_PER_MINUTE=60
API_VOICE_REQUESTS_PER_MINUTE=6
